{
  "name": "anima-use-google",
  "version": "0.1.7",
  "description": "oh-my-pi (omp) plugin that runs Google AI Mode searches via a browser sidecar extension using your own logged-in session.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "anima-use-google-cli": "dist/cli.js"
  },
  "files": [
    "dist",
    "native-host",
    "extension",
    "extension-chromium",
    "AGENTS.md",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "prepare": "tsc -p .",
    "prepublishOnly": "tsc -p ."
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "omp": {
    "extensions": [
      "./src/omp-extension.ts"
    ]
  }
}
