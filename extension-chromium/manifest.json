{
  "manifest_version": 3,
  "name": "Anima-use-google",
  "version": "0.1.5",
  "description": "Chromium sidecar extension that runs Google AI Mode searches for the anima-use-google MCP server using your own logged-in session.",
  "permissions": [
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*"
      ],
      "js": ["src/selectors.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
